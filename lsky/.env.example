# Lsky Pro 运行配置样例（部署时复制为 .env 并填入真实值）
# 注意：APP_KEY 必须 32 字节 base64；首次可由入口脚本自动生成，或自行用
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# 生成。下方值为占位符，切勿直接用于生产。

APP_NAME="Lsky Pro"
APP_ENV=prod
APP_KEY=base64:REPLACE_WITH_32_BYTE_BASE64_KEY
APP_DEBUG=false
APP_URL=https://pic.damingxing.vip

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=/var/www/lsky/storage/app/lsky.sqlite
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
